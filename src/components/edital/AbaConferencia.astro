---
// Aba "Conferência": o resultado item a item contra o catálogo (wireframe: Edital · Compatível / Revisão / Parcial).
// Componente Alpine "conferencia" (src/scripts/app.ts). Os itens vêm do <script id="conferencia-dados">.
interface Props {
	slug: string;
}
const { slug } = Astro.props;
const linha = "grid w-full grid-cols-[3rem_1fr] gap-x-3 gap-y-1 px-4 py-3 text-left md:grid-cols-[3rem_1fr_7rem_8rem_10rem] md:items-center";
---

<div x-data={`conferencia('${slug}')`} class="space-y-6">
	<!-- Resultado geral -->
	<div class="p-6 bg-white border border-gray-100 rounded-md shadow-sm">
		<div class="flex flex-wrap items-center gap-3">
			<span class="text-xs font-medium uppercase text-gray-500">Resultado</span>
			<span
				class="rounded-md px-3 py-1 text-sm font-semibold"
				x-bind:class="{ 'bg-green-50 text-green-700': situacao === 'compativeis', 'bg-orange-50 text-orange-600': situacao === 'revisao', 'bg-blue-50 text-blue-600': situacao === 'parcial', 'bg-gray-100 text-gray-500': situacao === 'sem_itens' }"
				x-text="({ compativeis: 'Compatível', revisao: 'Revisão necessária', parcial: 'Parcial', sem_itens: 'Sem itens do seu catálogo' })[situacao]"
			></span>
		</div>
		<p class="mt-3 text-sm font-medium text-gray-600">
			<span x-text="conta('ok')"></span> ✓ conferidos ·
			<span x-text="conta('mesmo_tipo')"></span> ◐ mesmo tipo ·
			<span x-text="conta('revisao')"></span> ⚠ para revisar ·
			<span x-text="conta('nao_atende')"></span> ✗ não atendem ·
			<span x-text="fora.length"></span> fora do seu catálogo
		</p>
		<p class="mt-2 text-xs text-gray-400">
			Simulação com o <a class="underline" href="/catalogo/">catálogo de exemplo</a>. Cada ✓ e ✗ mostra o trecho do edital que decidiu.
		</p>
	</div>

	<!-- Revisão necessária -->
	<section x-show="revisar.length" x-cloak>
		<h2 class="mb-3 text-lg font-semibold text-gray-800">Para revisar (<span x-text="revisar.length"></span>)</h2>
		<ul class="space-y-3">
			<template x-for="i in revisar" x-bind:key="i.n">
				<li class="p-5 bg-white border border-orange-200 rounded-md shadow-sm">
					<p class="text-sm font-semibold text-gray-800">
						<span x-text="'Nº ' + i.n + ' · ' + i.tipo.toLowerCase()"></span>
						<span class="font-medium text-gray-500" x-text="' · ' + $fmt.inteiro(i.qtd) + ' un.' + (i.produto ? ' · ' + i.produto : '') + (i.disp ? ' (' + i.disp + ')' : '')"></span>
					</p>
					<p class="mt-2 text-sm text-gray-700"><b class="font-semibold">Por que:</b> <span x-text="i.motivo"></span></p>
					<p x-show="i.prova" class="mt-1 text-xs text-gray-500">Trecho: “<span x-text="i.prova"></span>”</p>
					<div class="mt-3 flex flex-wrap gap-2">
						<button type="button" x-on:click="confirmar(i)" class="rounded-md bg-indigo-500 px-4 py-2 text-sm font-medium text-white shadow-xs hover:bg-indigo-600">☐ Confirmo que atende · Marcar como compatível</button>
						<a href="/catalogo/" class="rounded-md border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-500 shadow-xs hover:border-gray-300">Completar agora no catálogo</a>
					</div>
				</li>
			</template>
		</ul>
	</section>

	<!-- Parcial: lotes que você não completa -->
	<template x-for="l in lotesIncompletos()" x-bind:key="l.nome">
		<section class="p-5 bg-blue-50 border border-blue-100 rounded-md">
			<h2 class="font-semibold text-blue-700" x-text="l.nome + ': você atende ' + l.atende + ' de ' + l.total"></h2>
			<p class="mt-1 text-sm font-medium text-blue-600">Este lote obriga a fornecer todos os itens juntos. Sem o item que falta, você não pode disputar o lote.</p>
			<ul class="mt-3 space-y-1 text-sm">
				<template x-for="i in l.itens" x-bind:key="i.n">
					<li class="flex flex-wrap items-center gap-2">
						<span class="rounded-md px-2 py-0.5 text-xs font-semibold" x-bind:class="selo(res(i))[1]" x-text="selo(res(i))[0]"></span>
						<span class="text-gray-700" x-text="'Nº ' + i.n + ' · ' + i.tipo.toLowerCase() + (i.produto ? ' · ' + i.produto : '')"></span>
					</li>
				</template>
			</ul>
			<a href="/catalogo/" class="mt-3 inline-block rounded-md border border-blue-200 bg-white px-4 py-2 text-sm font-medium text-blue-600 shadow-xs">Cadastrar modelo</a>
		</section>
	</template>

	<!-- Itens que são seus (Flex UI › tables-03) -->
	<section class="overflow-hidden bg-white border border-gray-100 rounded-md shadow-sm">
		<div class="hidden h-11 items-center gap-x-3 border-b border-gray-100 bg-gray-50/80 px-4 text-xs font-semibold uppercase text-gray-500 md:grid md:grid-cols-[3rem_1fr_7rem_8rem_10rem]">
			<span>Item</span><span>Produto e resultado</span><span class="text-right">Qtd.</span><span class="text-right">Total</span><span>Seu modelo</span>
		</div>
		<ul class="divide-y divide-gray-100">
			<template x-for="i in seus" x-bind:key="i.n">
				<li>
					<button type="button" x-on:click="alternar(i.n)" class={`${linha} hover:bg-gray-50`}>
						<span class="text-sm font-semibold text-gray-800" x-text="'Nº ' + i.n"></span>
						<span class="min-w-0">
							<span class="block truncate text-sm font-medium text-gray-700" x-text="i.desc"></span>
							<span class="mt-1 flex flex-wrap items-center gap-2">
								<span class="rounded-md px-2 py-0.5 text-xs font-semibold" x-bind:class="selo(res(i))[1]" x-text="selo(res(i))[0]"></span>
								<span class="text-xs text-gray-500" x-text="i.tipo.toLowerCase()"></span>
								<span class="text-xs font-semibold text-indigo-500" x-show="confirmados[i.n]">confirmado por você</span>
							</span>
						</span>
						<span class="col-start-2 text-xs text-gray-500 md:col-start-auto md:text-right md:text-sm md:text-gray-700" x-text="$fmt.inteiro(i.qtd) + ' un.'"></span>
						<span class="col-start-2 text-sm font-semibold text-indigo-500 md:col-start-auto md:text-right" x-text="i.total ? $fmt.reais(i.total) : 'sigiloso'"></span>
						<span class="col-start-2 text-xs text-gray-500 md:col-start-auto" x-text="(i.produto || '-') + (i.disp ? ' · ' + i.disp : '')"></span>
					</button>
					<div x-show="aberto === i.n" x-cloak class="border-t border-gray-100 bg-gray-50/60 px-4 py-4 md:pl-[4.75rem]">
						<p class="text-sm text-gray-700" x-text="i.motivo"></p>
						<p x-show="i.prova" class="mt-2 rounded-md border border-gray-200 bg-white p-3 text-xs text-gray-600">
							<b class="font-semibold">Onde está no edital:</b> “<span x-text="i.prova"></span>”
						</p>
						<button type="button" x-show="confirmados[i.n]" x-on:click="desfazer(i)" class="mt-2 text-xs font-medium text-gray-500 underline">Desfazer a confirmação</button>
						<details class="mt-3 text-xs text-gray-500">
							<summary class="cursor-pointer font-medium">Texto completo do item</summary>
							<p class="mt-2 leading-relaxed" x-text="i.desc"></p>
						</details>
					</div>
				</li>
			</template>
		</ul>
		<p x-show="!seus.length" class="px-4 py-8 text-center text-sm font-medium text-gray-500">Nenhum item deste edital é do seu catálogo.</p>
	</section>

	<!-- Itens que você não vende -->
	<section x-show="fora.length">
		<button type="button" x-on:click="verFora = !verFora" class="text-sm font-medium text-gray-500 hover:text-indigo-500">
			<span x-text="(verFora ? '▾ ' : '▸ ') + fora.length + ' itens não estão no seu catálogo'"></span>
		</button>
		<ul x-show="verFora" x-cloak class="mt-3 divide-y divide-gray-100 rounded-md border border-gray-100 bg-white">
			<template x-for="i in fora" x-bind:key="i.n">
				<li class="flex gap-3 px-4 py-2 text-sm text-gray-400">
					<span class="w-12 shrink-0" x-text="'Nº ' + i.n"></span>
					<span class="truncate" x-text="i.desc"></span>
				</li>
			</template>
		</ul>
	</section>
</div>
