---
// Aba "Itens": os 92 itens com busca e filtros. A lista é montada no navegador
// pelo componente Alpine "listaItens" (src/scripts/app.ts), a partir do .json do edital.
import type { Edital } from "@data/editais";

interface Props {
	edital: Edital;
}
const { edital: e } = Astro.props;
const participacoes = [...new Set(e.itens.map((i) => i.participacao))];
---

<div x-data="listaItens" class="space-y-4">
	<!-- Filtros -->
	<div class="rounded-xl bg-white p-4 ring-1 ring-slate-200">
		<div class="grid gap-3 md:grid-cols-[1fr_14rem_12rem]">
			<label class="block">
				<span class="sr-only">Buscar</span>
				<input
					type="search"
					x-model.debounce.200ms="busca"
					placeholder="Buscar por palavra, nº do item ou código (ex.: notebook, 48, 87205)"
					class="w-full rounded-lg border-0 bg-slate-50 px-3 py-2 text-sm ring-1 ring-slate-200 placeholder:text-slate-400 focus:bg-white focus:ring-2 focus:ring-marca-500 focus:outline-hidden"
				/>
			</label>
			<label class="block">
				<span class="sr-only">Tipo de distribuidor</span>
				<select x-model="categoria" class="w-full rounded-lg border-0 bg-slate-50 px-3 py-2 text-sm ring-1 ring-slate-200 focus:ring-2 focus:ring-marca-500 focus:outline-hidden">
					<option value="">Todos os tipos</option>
					<template x-for="c in categorias" x-bind:key="c">
						<option x-bind:value="c" x-text="c"></option>
					</template>
				</select>
			</label>
			<label class="block">
				<span class="sr-only">Participação</span>
				<select x-model="participacao" class="w-full rounded-lg border-0 bg-slate-50 px-3 py-2 text-sm ring-1 ring-slate-200 focus:ring-2 focus:ring-marca-500 focus:outline-hidden">
					<option value="">Toda participação</option>
					{participacoes.map((p) => <option value={p}>{p}</option>)}
				</select>
			</label>
		</div>
		<div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
			<label class="inline-flex cursor-pointer items-center gap-2 text-slate-700">
				<input type="checkbox" x-model="soRamo" class="size-4 rounded border-slate-300 text-marca-600 focus:ring-marca-500" />
				Só do meu ramo
			</label>
			<label class="inline-flex cursor-pointer items-center gap-2 text-slate-700">
				<input type="checkbox" x-model="soAtencao" class="size-4 rounded border-slate-300 text-marca-600 focus:ring-marca-500" />
				Só com atenção
			</label>
			<label class="inline-flex items-center gap-2 text-slate-700">
				Ordenar:
				<select x-model="ordem" class="rounded-md border-0 bg-transparent py-0.5 pr-7 pl-1 text-sm font-medium ring-1 ring-slate-200 focus:ring-2 focus:ring-marca-500 focus:outline-hidden">
					<option value="numero">Nº do item</option>
					<option value="valor">Maior valor</option>
				</select>
			</label>
			<button type="button" x-cloak x-show="temFiltro" x-on:click="limpar()" class="font-medium text-marca-600 hover:text-marca-700">Limpar filtros</button>
		</div>
	</div>

	<!-- Contagem -->
	<p class="text-sm text-slate-600" x-cloak>
		Mostrando <b class="font-semibold text-slate-900" x-text="filtrados.length"></b> de <span x-text="itens.length"></span> itens ·
		<span x-text="$fmt.reais(totalFiltrado)"></span> estimados em 12 meses
	</p>

	<!-- Lista -->
	<div class="overflow-hidden rounded-xl bg-white ring-1 ring-slate-200">
		<!-- Cabeçalho (só no computador) -->
		<div class="hidden grid-cols-[4.5rem_1fr_8rem_8rem_9rem_2rem] gap-3 border-b border-slate-200 bg-slate-50 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-slate-500 md:grid">
			<span>Item</span><span>Produto</span><span class="text-right">Qtd.</span><span class="text-right">Unitário</span><span class="text-right">Total</span><span></span>
		</div>

		<ul class="divide-y divide-slate-100">
			<template x-for="i in filtrados" x-bind:key="i.n">
				<li>
					<button
						type="button"
						x-on:click="alternar(i.n)"
						x-bind:aria-expanded="aberto === i.n"
						class="grid w-full grid-cols-[3.5rem_1fr] gap-x-3 gap-y-1 px-4 py-3 text-left hover:bg-slate-50 md:grid-cols-[4.5rem_1fr_8rem_8rem_9rem_2rem] md:items-center"
					>
						<span class="row-span-2 md:row-span-1">
							<span class="block text-sm font-semibold text-slate-900" x-text="'Nº ' + i.n"></span>
							<span class="block text-[11px] text-slate-400" x-text="'TR ' + i.tr"></span>
						</span>
						<span class="min-w-0">
							<span class="block truncate text-sm font-medium text-slate-800" x-text="titulo(i)"></span>
							<span class="mt-1 flex flex-wrap items-center gap-1.5">
								<span class="text-xs text-slate-500" x-text="i.categoria"></span>
								<span
									class="rounded-full px-1.5 py-0.5 text-[11px] font-medium"
									x-bind:class="{ 'bg-emerald-50 text-emerald-700': i.ramo === 'Sim', 'bg-amber-50 text-amber-800': i.ramo === 'Talvez', 'bg-slate-100 text-slate-500': i.ramo === 'Não' }"
									x-text="i.ramo === 'Sim' ? 'Do seu ramo' : (i.ramo === 'Talvez' ? 'Talvez' : 'Fora do ramo')"
								></span>
								<span x-show="i.participacao.startsWith('Exclusivo')" class="rounded-full bg-marca-50 px-1.5 py-0.5 text-[11px] font-medium text-marca-700">ME/EPP</span>
								<span x-show="i.atencao.length" class="rounded-full px-1.5 py-0.5 text-[11px] font-semibold" x-bind:class="i.critico ? 'bg-red-50 text-red-700' : 'bg-amber-50 text-amber-800'">⚠ atenção</span>
							</span>
						</span>
						<span class="col-start-2 flex gap-3 text-xs text-slate-500 md:contents md:text-sm">
							<span class="tabular-nums md:text-right md:text-slate-700" x-text="$fmt.inteiro(i.qtd) + (i.und === 'metro' ? ' m' : ' un.')"></span>
							<span class="tabular-nums md:text-right md:text-slate-700" x-text="$fmt.reais(i.unit)"></span>
							<span class="font-semibold tabular-nums text-slate-900 md:text-right" x-text="$fmt.reais(i.total)"></span>
						</span>
						<span class="hidden justify-self-end text-slate-400 md:block" aria-hidden="true">
							<svg class="size-4 transition-transform" x-bind:class="aberto === i.n && 'rotate-180'" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg>
						</span>
					</button>

					<!-- Detalhe do item -->
					<div x-show="aberto === i.n" x-cloak class="border-t border-slate-100 bg-slate-50/60 px-4 py-4 md:pl-[6.25rem]">
						<template x-if="i.atencao.length">
							<div class="mb-4 rounded-lg p-3 text-sm" x-bind:class="i.critico ? 'bg-red-50 text-red-800' : 'bg-amber-50 text-amber-900'">
								<p class="font-semibold">Atenção</p>
								<ul class="mt-1 list-disc space-y-1 pl-5">
									<template x-for="a in i.atencao"><li x-text="a"></li></template>
								</ul>
							</div>
						</template>
						<div class="grid gap-4 lg:grid-cols-[1fr_16rem]">
							<div>
								<p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Requisitos, um por linha</p>
								<ul class="mt-2 space-y-1 text-sm text-slate-700">
									<template x-for="r in i.requisitos"><li class="flex gap-2"><span class="text-slate-300">•</span><span x-text="r"></span></li></template>
								</ul>
							</div>
							<dl class="space-y-3 text-sm">
								<div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Garantia exigida</dt><dd class="mt-0.5 text-slate-700" x-text="i.garantia"></dd></div>
								<div x-show="i.certificacoes.length">
									<dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Certificações e licenças</dt>
									<dd class="mt-0.5 text-slate-700"><template x-for="c in i.certificacoes"><span class="block" x-text="c"></span></template></dd>
								</div>
								<div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Participação</dt><dd class="mt-0.5 text-slate-700" x-text="i.participacao"></dd></div>
								<div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Código COPLAN</dt><dd class="mt-0.5 text-slate-700" x-text="i.cod"></dd></div>
							</dl>
						</div>
						<details class="mt-4 text-sm">
							<summary class="cursor-pointer font-medium text-slate-500 hover:text-slate-700">Texto original do edital</summary>
							<p class="mt-2 text-xs leading-relaxed text-slate-500" x-text="i.desc"></p>
						</details>
					</div>
				</li>
			</template>
		</ul>

		<div x-cloak x-show="filtrados.length === 0" class="px-4 py-10 text-center text-sm text-slate-500">
			Nenhum item com esses filtros. <button type="button" x-on:click="limpar()" class="font-medium text-marca-600">Limpar filtros</button>
		</div>
	</div>
</div>
