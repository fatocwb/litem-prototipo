---
// Aba "Pontos de atenção": o que pode desclassificar ou dar prejuízo, por que importa e o que fazer.
import type { Edital } from "@data/editais";

interface Props {
	edital: Edital;
}
const { edital: e } = Astro.props;
---

<div class="space-y-3">
	<p class="text-sm text-slate-600">
		Os {e.pontos.filter((p) => p.prioridade).length} primeiros são os que mais desclassificam ou dão prejuízo. Cada ponto diz onde está escrito no edital.
	</p>
	<ol class="space-y-3">
		{
			e.pontos.map((p) => (
				<li class={`rounded-xl bg-white p-4 ring-1 sm:p-5 ${p.prioridade ? "ring-amber-300" : "ring-slate-200"}`}>
					<div class="flex items-start gap-3">
						<span class={`grid size-7 shrink-0 place-items-center rounded-full text-sm font-semibold ${p.prioridade ? "bg-amber-100 text-amber-800" : "bg-slate-100 text-slate-600"}`}>
							{p.n}
						</span>
						<div class="min-w-0 flex-1">
							<div class="flex flex-wrap items-center gap-2">
								<h3 class="font-semibold text-slate-900">{p.titulo}</h3>
								{p.prioridade && <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-800">Prioridade</span>}
							</div>
							<div class="mt-3 grid gap-3 lg:grid-cols-2">
								<div>
									<p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Por que importa</p>
									<p class="mt-1 text-sm leading-relaxed text-slate-700">{p.porque}</p>
								</div>
								<div class="rounded-lg bg-emerald-50/70 p-3">
									<p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">O que fazer</p>
									<p class="mt-1 text-sm leading-relaxed text-slate-800">{p.fazer}</p>
								</div>
							</div>
							<p class="mt-2 text-xs text-slate-400">Onde está: {p.onde}</p>
						</div>
					</div>
				</li>
			))
		}
	</ol>
</div>
