---
// Topo da página do edital: nome, órgão, datas que importam e links oficiais.
import type { Edital } from "@data/editais";
import { dataBR } from "@scripts/formatar";

interface Props {
	edital: Edital;
}
const { edital: e } = Astro.props;
const horaDisputa = e.datas.disputa.slice(11, 16).replace(":", "h");
const chips = [`Disputa na ${e.plataforma.nome}`, e.modo, e.julgamento, "Ata de 12 meses"];
---

<div>
	<nav class="mb-3 text-sm text-slate-500" aria-label="Caminho">
		<a href="/" class="hover:text-slate-700">Editais</a>
		<span class="mx-1.5">/</span>
		<span class="text-slate-700">{e.cidade}-{e.uf}</span>
	</nav>

	<div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
		<div class="min-w-0">
			<h1 class="text-xl font-bold tracking-tight text-slate-900 sm:text-3xl">{e.titulo}</h1>
			<p class="mt-1 text-sm text-slate-600 sm:text-base">{e.orgao}-{e.uf} · {e.objeto}</p>
			<ul class="mt-3 flex flex-wrap gap-2">
				{chips.map((c) => <li class="rounded-full bg-white px-3 py-1 text-xs font-medium text-slate-600 ring-1 ring-slate-200">{c}</li>)}
			</ul>
		</div>
		<div class="hidden shrink-0 gap-2 sm:flex">
			<a href={e.links.pncp} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-medium text-slate-700 ring-1 ring-slate-200 hover:bg-slate-50">
				Ver no PNCP <span aria-hidden="true">↗</span>
			</a>
			{
				e.links.prefeitura && (
					<a href={e.links.prefeitura} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-medium text-slate-700 ring-1 ring-slate-200 hover:bg-slate-50">
						Edital em PDF <span aria-hidden="true">↗</span>
					</a>
				)
			}
		</div>
	</div>

	<!-- As duas datas que mais importam -->
	<div class="mt-5 grid gap-3 sm:grid-cols-2">
		<div class="flex items-center gap-4 rounded-xl bg-white p-3 ring-1 ring-slate-200 sm:p-4">
			<div class="hidden size-12 shrink-0 place-items-center rounded-lg sm:grid bg-marca-50 text-marca-700">
				<svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"></path></svg>
			</div>
			<div>
				<p class="text-xs font-medium uppercase tracking-wide text-slate-500">Disputa</p>
				<p class="text-lg font-semibold text-slate-900">{dataBR(e.datas.disputa)} às {horaDisputa}</p>
				<p class="text-sm text-slate-500" x-data={`faltam('${e.datas.disputa}')`} x-text="texto">Horário de Brasília</p>
			</div>
		</div>
		<div class="flex items-center gap-4 rounded-xl bg-white p-3 ring-1 ring-amber-300 sm:p-4">
			<div class="hidden size-12 shrink-0 place-items-center rounded-lg sm:grid bg-amber-50 text-amber-700">
				<svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"></path></svg>
			</div>
			<div>
				<p class="text-xs font-medium uppercase tracking-wide text-slate-500">Prazo para pedir esclarecimento</p>
				<p class="text-lg font-semibold text-slate-900">Até {dataBR(e.datas.esclarecimentoAte)}</p>
				<p class="text-sm text-slate-500"><span x-data={`faltam('${e.datas.esclarecimentoAte}')`} x-text="texto"></span>{e.notaEsclarecimento && ` · ${e.notaEsclarecimento}`}</p>
			</div>
		</div>
	</div>
</div>
