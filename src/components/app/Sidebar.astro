---
// Menu lateral com a estrutura final do produto (decisões do projeto, seção "Telas").
// Itens que ainda não existem no protótipo aparecem com a etiqueta da versão.
interface Props {
	ativo: string;
}
const { ativo } = Astro.props;

const itens = [
	{ id: "geral", nome: "Editais", href: "/", versao: null, icone: "M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" },
	{ id: "catalogo", nome: "Meu Catálogo", href: null, versao: "V1", icone: "M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m16.5 0H3.75m16.5 0l-1.5-3h-13.5l-1.5 3" },
	{ id: "propostas", nome: "Minhas Propostas", href: null, versao: "V2", icone: "M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08M15.75 18.75v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5A3.375 3.375 0 006.375 7.5H5.25" },
	{ id: "documentos", nome: "Documentos", href: null, versao: "V2", icone: "M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" },
	{ id: "mercado", nome: "Inteligência de Mercado", href: null, versao: "V1.1", icone: "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" },
	{ id: "config", nome: "Configurações", href: null, versao: "V1", icone: "M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" },
];
---

<div class="flex h-full flex-col">
	<div class="flex h-16 items-center gap-2 px-5">
		<span class="text-xl font-bold tracking-tight">Li<span class="text-marca-600">Tem</span></span>
		<span class="rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-800">Protótipo</span>
	</div>

	<nav class="flex-1 space-y-1 px-3 py-2" aria-label="Menu principal">
		{
			itens.map((i) => {
				const marcado = i.id === ativo;
				const classe = marcado
					? "bg-marca-50 text-marca-700"
					: i.href
						? "text-slate-700 hover:bg-slate-100"
						: "text-slate-400 cursor-not-allowed";
				const conteudo = (
					<>
						<svg class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d={i.icone} />
						</svg>
						<span class="flex-1">{i.nome}</span>
						{!i.href && (
							<span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold text-slate-500" title="Ainda não está no protótipo">
								{i.versao}
							</span>
						)}
					</>
				);
				return i.href ? (
					<a href={i.href} class={`flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium ${classe}`} aria-current={marcado ? "page" : undefined}>
						{conteudo}
					</a>
				) : (
					<span class={`flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium ${classe}`} title="Em breve">
						{conteudo}
					</span>
				);
			})
		}
	</nav>

	<div class="m-3 rounded-lg bg-slate-50 p-3 text-xs leading-relaxed text-slate-500">
		<b class="font-semibold text-slate-700">LiTem</b> · licitações conferidas item a item. Protótipo para demonstração: os dados vêm de um edital real, sem sistema por trás.
	</div>
</div>
