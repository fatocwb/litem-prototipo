---
// Menu lateral. Base: Flex UI › dashboard › navigation › vertical-02 (mesmas classes e estrutura),
// com os itens do LiTem (decisões do projeto, seção "Telas") e o abrir/fechar no celular pelo Alpine.js.
// Itens que ainda não existem no protótipo aparecem com a etiqueta da versão.
import { ICONES } from "./icones-flex";

interface Props {
	ativo: string;
}
const { ativo } = Astro.props;

const principal = [
	{ id: "editais", nome: "Geral", href: "/", versao: null },
	{ id: "catalogo", nome: "Meu Catálogo", href: "/catalogo/", versao: null },
	{ id: "propostas", nome: "Minhas Propostas", href: "/propostas/", versao: "V2" },
	{ id: "documentos", nome: "Documentos", href: "/documentos/", versao: "V2" },
	{ id: "mercado", nome: "Inteligência de Mercado", href: "/mercado/", versao: "V1.1" },
];
const ajustes = [{ id: "config", nome: "Configurações", href: "/configuracoes/", versao: null }];

const classeLink = "p-3 py-4 flex items-center justify-between rounded-md";
---

<!-- Topo no celular (Flex vertical-02) -->
<div class="relative z-30 flex items-center justify-between xl:hidden bg-gray-50 px-8 py-5 -mx-3">
	<div class="w-auto px-3">
		<a class="block max-w-max text-2xl font-bold tracking-tight text-gray-900" href="/">Li<span class="text-indigo-500">Tem</span></a>
	</div>
	<div class="w-auto px-3">
		<button type="button" class="self-center ml-auto block xl:hidden" aria-label="Abrir menu" x-on:click="menuAberto = true">
			<svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 32 32" fill="none" aria-hidden="true">
				<rect class="text-gray-100" width="32" height="32" rx="6" fill="currentColor"></rect>
				<path class="text-gray-400" d="M7 12H25a1 1 0 0 0 0-2H7a1 1 0 0 0 0 2Zm18 3H7a1 1 0 0 0 0 2h18a1 1 0 0 0 0-2Zm0 5H7a1 1 0 0 0 0 2h18a1 1 0 0 0 0-2Z" fill="currentColor"></path>
			</svg>
		</button>
	</div>
</div>

<!-- Menu: fixo no computador (xl), gaveta no celular -->
<div
	class="z-50 fixed top-0 left-0 hidden flex-col justify-between bg-gray-50 max-w-xs w-9/12 h-full overflow-y-auto xl:flex"
	x-bind:class="menuAberto && 'flex!'"
>
	<div class="relative bg-gray-50">
		<div class="p-8 pb-6">
			<a class="flex items-center gap-2 max-w-max" href="/">
				<span class="text-2xl font-bold tracking-tight text-gray-900">Li<span class="text-indigo-500">Tem</span></span>
				<span class="rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-semibold text-yellow-800">Protótipo</span>
			</a>
		</div>
		<div>
			<p class="px-8 mb-2 text-xs font-medium text-gray-500 uppercase">Menu</p>
			<ul class="px-4 mb-8">
				{
					principal.map((i) => {
						const marcado = i.id === ativo;
						const corTexto = marcado ? "text-indigo-500" : i.href ? "text-gray-700" : "text-gray-400";
						const corLink = marcado ? "bg-white text-indigo-500 shadow-xs" : i.href ? "text-gray-500 hover:text-indigo-500 hover:bg-white" : "text-gray-300 cursor-not-allowed";
						const miolo = (
							<>
								<div class="flex items-center">
									<svg xmlns="http://www.w3.org/2000/svg" class="mr-2 shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path d={ICONES[i.id]} fill="currentColor" />
									</svg>
									<p class={`font-medium text-base ${corTexto}`}>{i.nome}</p>
								</div>
								{i.versao && <span class="rounded-sm bg-gray-100 px-1.5 py-0.5 text-xs font-semibold text-gray-500">{i.versao}</span>}
							</>
						);
						return (
							<li>
								{i.href ? (
									<a class={`${classeLink} ${corLink}`} href={i.href} aria-current={marcado ? "page" : undefined}>
										{miolo}
									</a>
								) : (
									<span class={`${classeLink} ${corLink}`} title="Ainda não está no protótipo">
										{miolo}
									</span>
								)}
							</li>
						);
					})
				}
			</ul>
		</div>
	</div>
	<div class="relative bg-gray-50 flex-1"></div>
	<div class="relative bg-gray-50">
		<p class="px-8 mb-2 text-xs font-medium text-gray-500 uppercase">Ajustes</p>
		<ul class="px-4 pb-6">
			{
				ajustes.map((i) => {
					const marcado = i.id === ativo;
					return (
						<li>
							<a class={`${classeLink} ${marcado ? "bg-white text-indigo-500 shadow-xs" : "text-gray-500 hover:text-indigo-500 hover:bg-white"}`} href={i.href} aria-current={marcado ? "page" : undefined}>
								<div class="flex items-center">
									<svg xmlns="http://www.w3.org/2000/svg" class="mr-2 shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path d={ICONES[i.id]} fill="currentColor" />
									</svg>
									<p class={`font-medium text-base ${marcado ? "text-indigo-500" : "text-gray-700"}`}>{i.nome}</p>
								</div>
							</a>
						</li>
					);
				})
			}
		</ul>
		<div class="mx-4 mb-6 rounded-md border border-gray-100 bg-white p-4 text-xs font-medium leading-relaxed text-gray-500">
			<b class="font-semibold text-gray-700">LiTem</b> · licitações conferidas item a item. Protótipo de demonstração: editais reais do PNCP, conferência simulada com um catálogo de exemplo. <a class="text-indigo-500" href="/primeiro-acesso/">Ver o primeiro acesso</a>.
		</div>
	</div>
</div>
