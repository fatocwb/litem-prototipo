---
// Tela "Em breve" das funções de versões futuras (decisão: itens ainda não prontos mostram uma prévia
// apagada e o botão "Quero ser avisado"; os cliques medem o interesse).
interface Props {
	funcao: string; // nome usado para guardar o clique
	versao: string;
	descricao: string;
}
const { funcao, versao, descricao } = Astro.props;
---

<section class="min-h-screen bg-gray-50 py-8 text-gray-800">
	<div class="container mx-auto px-4 sm:px-6">
		<div class="relative overflow-hidden rounded-md border border-gray-100 bg-white shadow-sm">
			<div class="pointer-events-none select-none p-6 opacity-40 blur-[2px]" aria-hidden="true">
				<slot />
			</div>
			<div class="absolute inset-0 grid place-items-center p-6" x-data={`{ ok: $lerLocal('litem:aviso:${funcao}', false) }`}>
				<div class="max-w-md rounded-md border border-gray-100 bg-white p-6 text-center shadow-sm">
					<span class="rounded-md bg-indigo-100 px-2 py-0.5 text-xs font-semibold text-indigo-500">{versao} · Em breve</span>
					<p class="mt-3 text-sm font-medium text-gray-600">{descricao}</p>
					<button
						type="button"
						class="mt-4 rounded-md bg-indigo-500 px-4 py-2 text-sm font-medium text-white shadow-xs hover:bg-indigo-600"
						x-on:click={`ok = true; $guardar('litem:aviso:${funcao}', true)`}
						x-text="ok ? 'Pronto, vamos te avisar ✓' : 'Quero ser avisado'"
					/>
				</div>
			</div>
		</div>
	</div>
</section>
