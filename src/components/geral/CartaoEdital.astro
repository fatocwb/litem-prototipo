---
// Cartão de um edital na página Geral (wireframe do Miro: Geral · Compatíveis / Revisão / Parcial / Editais Gerais).
// Cor da borda = resultado: verde compatível, laranja revisão, azul parcial, tracejado sem itens, cinza fora do setor.
import { dataBR, reaisCurto } from "@scripts/formatar";
import { ALERTA } from "@components/app/icones-flex";

interface Props {
	e: any; // um item de src/data/geral.json
	k: number; // posição na lista (usada pelos filtros do Alpine)
}
const { e, k } = Astro.props;
const c = e.cartao;

const estilo: Record<string, { borda: string; rotulo: string; cor: string }> = {
	compativeis: { borda: "border-2 border-green-500 bg-white", rotulo: "Compatível", cor: "text-green-700" },
	revisao: { borda: "border-2 border-orange-400 bg-white", rotulo: "Revisão necessária", cor: "text-orange-600" },
	parcial: { borda: "border-2 border-blue-500 bg-white", rotulo: "Parcial", cor: "text-blue-600" },
	sem_itens: { borda: "border-2 border-dashed border-gray-300 bg-white", rotulo: "Sem itens do seu catálogo", cor: "text-gray-500" },
	fora_nicho: { borda: "border border-gray-300 bg-gray-100", rotulo: "Setor ainda sem conferência", cor: "text-gray-500" },
};
const s = estilo[e.aba];
const modoAjuda: Record<string, string> = {
	Aberto: "Lances públicos e sucessivos; lance no fim prorroga o tempo.",
	"Aberto-Fechado": "Lances abertos e, no fim, um lance final secreto dos melhores colocados.",
	"Fechado-Aberto": "Primeiro uma proposta secreta; os melhores passam para os lances abertos.",
	Fechado: "Proposta secreta única.",
};
const href = e.slug ? `/editais/${e.slug}/` : e.pncp;
const conta = c && `${c.ok + c.mesmo_tipo + c.revisao} de ${c.total} itens são seus`;
const detalhe =
	c &&
	[c.ok && `${c.ok} ✓`, c.mesmo_tipo && `${c.mesmo_tipo} ◐`, c.revisao && `${c.revisao} ⚠`, c.nao_atende && `${c.nao_atende} ✗`].filter(Boolean).join(" · ");
---

<article x-show={`mostra(${k})`} class={`flex flex-col rounded-md p-5 shadow-sm ${s.borda}`}>
	<div class="flex flex-wrap items-center gap-2">
		<span class={`text-xs font-semibold uppercase ${s.cor}`}>{s.rotulo}</span>
		{
			e.slug && (
				<span
					class="text-xs font-semibold"
					x-bind:class={`visto('${e.slug}') ? 'text-gray-400' : 'text-green-700'`}
					x-text={`visto('${e.slug}') ? '○ ABERTO' : '● NOVO'`}
				/>
			)
		}
		{e.atualizado && e.slug && <span class="text-xs font-semibold text-indigo-500">↻ ATUALIZADO</span>}
		{e.tipo === "ilustrativo" && <span class="rounded-md bg-yellow-100 px-2 py-0.5 text-xs font-semibold text-yellow-800">Exemplo fictício</span>}
		{
			e.slug && (
				<span class="ml-auto rounded-md border border-gray-200 bg-gray-50 px-2 py-0.5 text-xs font-medium text-gray-500">
					{e.tipo === "real" ? "✔ Análise profunda" : "🔎 Triagem"}
				</span>
			)
		}
	</div>

	<h3 class="mt-3 font-semibold text-gray-800">{e.titulo}</h3>
	<p class="text-sm font-medium text-gray-500">
		{e.orgao} · {e.cidade}-{e.uf}
		{e.disputa && <> · abre {dataBR(e.disputa)}</>}
	</p>

	{
		e.aba === "fora_nicho" ? (
			<>
				<p class="mt-2 line-clamp-2 text-sm text-gray-600">{e.objeto}</p>
				<div class="mt-3 flex gap-2 rounded-md bg-white/70 p-3 text-xs font-medium text-gray-600">
					<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 shrink-0 text-yellow-500" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path d={ALERTA} fill="currentColor" />
					</svg>
					Este setor ainda não tem conferência no LiTem: sem comparação com o seu catálogo e sem análise profunda. Os dados vêm direto do PNCP.
				</div>
				<div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-3 text-sm font-medium">
					{e.pncp && (
						<a class="text-indigo-500 hover:text-indigo-600" href={e.pncp} target="_blank" rel="noopener">
							Ver no PNCP ↗
						</a>
					)}
					<button type="button" class="text-gray-500 hover:text-indigo-500" x-on:click={`queroSetor(${k})`} x-text={`pedidos[${k}] ? 'Pedido registrado ✓' : 'Quero conferência para este setor'`} />
				</div>
			</>
		) : (
			<>
				<dl class="mt-3 space-y-1 text-sm text-gray-600">
					<div>
						Disputa em: <b class="font-semibold text-gray-800">{e.plataforma?.nome}</b>
					</div>
					<div>
						Modo: <b class="font-semibold text-gray-800">{e.modo}</b>
						{modoAjuda[e.modo] && (
							<span class="cursor-help text-gray-400" title={modoAjuda[e.modo]}>
								{" "}
								ⓘ
							</span>
						)}
					</div>
					{e.forma && <div class="text-gray-500">{e.forma}</div>}
					{c && (
						<div>
							<b class="font-semibold text-gray-800">{conta}</b>
							{detalhe && <span> · {detalhe}</span>}
							{c.valorSeus > 0 && <span> · {reaisCurto(c.valorSeus)}</span>}
						</div>
					)}
					{c && (c.emEstoque || c.sobEncomenda) ? (
						<div>
							Estoque: {[c.emEstoque && `${c.emEstoque} em estoque`, c.sobEncomenda && `${c.sobEncomenda} sob encomenda`].filter(Boolean).join(" · ")}
						</div>
					) : null}
					{!c && <p class="line-clamp-2 text-gray-500">{e.objeto}</p>}
				</dl>
				<div class="mt-auto pt-4">
					{href && (
						<a
							class="text-sm font-semibold text-indigo-500 hover:text-indigo-600"
							href={href}
							target={e.slug ? undefined : "_blank"}
							rel={e.slug ? undefined : "noopener"}
							x-on:click={e.slug ? `marcarVisto('${e.slug}')` : undefined}
						>
							{e.slug ? "Ver detalhes →" : "Ver no PNCP ↗"}
						</a>
					)}
				</div>
			</>
		)
	}
</article>
