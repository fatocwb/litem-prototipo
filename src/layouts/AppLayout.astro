---
// Casca do aplicativo: menu lateral (Flex UI vertical-02) + conteúdo.
// Toda página do protótipo usa este layout.
import "@styles/global.css";
import Sidebar from "@components/app/Sidebar.astro";

interface Props {
	title: string;
	ativo?: string; // item do menu lateral que fica marcado
}
const { title, ativo = "editais" } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} · LiTem</title>
	</head>
	<body class="bg-white text-gray-800 antialiased" x-data="casca" x-on:keydown.escape="menuAberto = false">
		<section class="overflow-hidden min-h-screen text-gray-800">
			<!-- Fundo escuro atrás do menu, só no celular (Flex: navbar-backdrop) -->
			<div class="fixed xl:hidden inset-0 z-40 bg-gray-800 opacity-60" x-cloak x-show="menuAberto" x-on:click="menuAberto = false"></div>

			<Sidebar ativo={ativo} />

			<!-- Conteúdo da página (Flex: a div "xl:ml-80" no fim do componente) -->
			<div class="xl:ml-80">
				<slot />
			</div>
		</section>

		<script>
			import "@scripts/app.ts";
		</script>
	</body>
</html>
