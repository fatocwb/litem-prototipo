---
// Meu Catálogo (wireframe do Miro: "Meu Catálogo"). Um catálogo por CNPJ, organizado por famílias.
import AppLayout from "@layouts/AppLayout.astro";
import Titulo from "@components/comum/Titulo.astro";
import { familias, produtos } from "@data/catalogo";
import { ICONES_STATS } from "@components/app/icones-flex";

const editaisCompat = new Set(familias.flatMap((f) => f.produtos)).size;
const numeros = [
	{ valor: produtos.length, rotulo: "Produtos" },
	{ valor: familias.length, rotulo: "Famílias" },
	{ valor: familias.reduce((s, f) => s + f.incompletas, 0), rotulo: "Fichas incompletas" },
	{ valor: Math.round(familias.reduce((s, f) => s + f.ficha, 0) / familias.length) + "%", rotulo: "Ficha média completa" },
];
const btn = "rounded-md px-4 py-2 text-sm font-medium shadow-xs";
---

<AppLayout title="Meu Catálogo" ativo="catalogo">
	<Titulo titulo="Meu Catálogo" sub="Catálogo de exemplo (marca fictícia TesteTech) · um catálogo por CNPJ, organizado por famílias">
		<a href="/catalogo/importar/" class={`${btn} bg-indigo-500 text-white hover:bg-indigo-600`}>Importar ou atualizar catálogo</a>
		<span class={`${btn} border border-gray-200 bg-white text-gray-500`} title="No protótipo o download não está ligado">Baixar planilha-modelo</span>
	</Titulo>

	<section class="min-h-screen bg-gray-50 py-8 text-gray-800">
		<div class="container mx-auto space-y-6 px-4 sm:px-6">
			<!-- Números (Flex UI › stats-04) -->
			<div class="flex flex-wrap -m-3">
				{
					numeros.map((n, k) => (
						<div class="w-1/2 lg:w-1/4 p-3">
							<div class="h-full p-6 bg-white border border-gray-100 rounded-md shadow-sm">
								<div class="mb-4 max-w-max bg-indigo-100 text-indigo-500 p-3 rounded-md">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
										<path d={ICONES_STATS[(k + 1) % ICONES_STATS.length]} fill="currentColor" />
									</svg>
								</div>
								<h2 class="font-semibold text-2xl text-gray-800 tracking-tighter">{n.valor}</h2>
								<p class="text-xs font-medium text-gray-500">{n.rotulo}</p>
							</div>
						</div>
					))
				}
			</div>

			<!-- Famílias -->
			<div class="grid gap-4 md:grid-cols-2">
				{
					familias.map((f) => (
						<a href={`/catalogo/${f.slug}/`} class="block p-6 bg-white border border-gray-100 rounded-md shadow-sm hover:border-indigo-200">
							<div class="flex items-start justify-between gap-3">
								<h3 class="font-semibold text-gray-800">{f.nome}</h3>
								<span class="text-sm font-semibold text-indigo-500">Abrir →</span>
							</div>
							<p class="mt-1 text-sm font-medium text-gray-500">
								{f.produtos.length} produtos · {f.editais} {f.editais === 1 ? "edital compatível" : "editais compatíveis"} · {f.incompletas} {f.incompletas === 1 ? "ficha incompleta" : "fichas incompletas"}
							</p>
							<div class="mt-4 flex items-center gap-3">
								<div class="h-2 flex-1 overflow-hidden rounded-full bg-gray-100">
									<div class="h-full rounded-full bg-indigo-500" style={`width:${f.ficha}%`} />
								</div>
								<span class="text-xs font-medium text-gray-500">Ficha {f.ficha}% completa</span>
							</div>
						</a>
					))
				}
			</div>
			<p class="text-xs text-gray-400">A ficha completa prioriza os campos mais pedidos nos editais (ex.: no notebook, RAM, SSD, núcleos, tela e garantias disponíveis). Campo vazio nunca reprova: o edital vai para "Revisão necessária".</p>
		</div>
	</section>
</AppLayout>
