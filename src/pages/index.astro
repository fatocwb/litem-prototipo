---
// Página inicial do protótipo: lista dos editais que já têm análise.
// Por enquanto é um só (Barra do Garças). As abas da triagem (Compatíveis, Revisão, Parcial)
// entram quando o wireframe inteiro for refeito aqui.
import AppLayout from "@layouts/AppLayout.astro";
import SeloRamo from "@components/app/SeloRamo.astro";
import { editais } from "@data/editais";
import { dataBR, reaisCurto } from "@scripts/formatar";
---

<AppLayout title="Editais">
	<!-- Título (Flex UI › page-heading-02, sem botões) -->
	<section class="bg-white p-6 sm:p-8 text-gray-800">
		<h1 class="font-semibold text-black text-2xl sm:text-3xl">Editais</h1>
		<p class="mt-1 text-sm font-medium text-gray-500">Editais já lidos item a item. Clique para ver o resumo, os pontos de atenção, os itens e os pedidos de cotação.</p>
	</section>

	<section class="min-h-screen bg-gray-50 py-8 text-gray-800">
	<ul class="container mx-auto grid gap-4 px-4 sm:px-6 lg:grid-cols-2">
		{
			editais.map((e) => {
				const doRamo = e.itens.filter((i) => i.ramo !== "Não");
				return (
					<li>
						<a href={`/editais/${e.slug}/`} class="block rounded-md border border-l-4 border-gray-100 border-l-emerald-500 bg-white p-6 shadow-sm transition hover:shadow-md">
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0">
									<p class="text-xs font-medium text-gray-500">
										{e.orgao}-{e.uf}
									</p>
									<h2 class="mt-0.5 font-semibold text-gray-900">{e.titulo}</h2>
									<p class="mt-0.5 text-sm text-gray-600">{e.objeto}</p>
								</div>
								<span class="shrink-0 rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-600">● Novo</span>
							</div>
							<dl class="mt-4 grid grid-cols-3 gap-3 text-sm">
								<div>
									<dt class="text-xs text-gray-500">Disputa</dt>
									<dd class="font-medium text-gray-800">{dataBR(e.datas.disputa)}</dd>
									<dd class="text-xs text-gray-500" x-data={`faltam('${e.datas.disputa}')`} x-text="texto" />
								</div>
								<div>
									<dt class="text-xs text-gray-500">Valor estimado</dt>
									<dd class="font-medium text-gray-800">{reaisCurto(e.valorTotal)}</dd>
								</div>
								<div>
									<dt class="text-xs text-gray-500">Seus itens</dt>
									<dd class="font-medium text-gray-800">
										{doRamo.length} de {e.itens.length}
									</dd>
								</div>
							</dl>
							<p class="mt-4 flex flex-wrap items-center gap-2 text-xs text-gray-500">
								<SeloRamo ramo="Sim" /> Disputa em: {e.plataforma.nome} · {e.modo}
							</p>
						</a>
					</li>
				);
			})
		}
	</ul>
	</section>
</AppLayout>
