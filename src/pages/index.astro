---
// Página inicial do protótipo: lista dos editais que já têm análise.
// Por enquanto é um só (Barra do Garças). As abas da triagem (Compatíveis, Revisão, Parcial)
// entram quando o wireframe inteiro for refeito aqui.
import AppLayout from "@layouts/AppLayout.astro";
import SeloRamo from "@components/app/SeloRamo.astro";
import { editais } from "@data/editais";
import { dataBR, reaisCurto } from "@scripts/formatar";
---

<AppLayout title="Editais">
	<div class="flex flex-col gap-1">
		<h1 class="text-2xl font-bold tracking-tight text-slate-900">Editais</h1>
		<p class="text-sm text-slate-500">Editais já lidos item a item. Clique para ver o resumo, os pontos de atenção, os itens e os pedidos de cotação.</p>
	</div>

	<ul class="mt-6 grid gap-4 lg:grid-cols-2">
		{
			editais.map((e) => {
				const doRamo = e.itens.filter((i) => i.ramo !== "Não");
				return (
					<li>
						<a href={`/editais/${e.slug}/`} class="block rounded-xl border-l-4 border-emerald-500 bg-white p-5 ring-1 ring-slate-200 transition hover:shadow-md">
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0">
									<p class="text-xs font-medium text-slate-500">
										{e.orgao}-{e.uf}
									</p>
									<h2 class="mt-0.5 font-semibold text-slate-900">{e.titulo}</h2>
									<p class="mt-0.5 text-sm text-slate-600">{e.objeto}</p>
								</div>
								<span class="shrink-0 rounded-full bg-marca-50 px-2 py-0.5 text-xs font-semibold text-marca-700">● Novo</span>
							</div>
							<dl class="mt-4 grid grid-cols-3 gap-3 text-sm">
								<div>
									<dt class="text-xs text-slate-500">Disputa</dt>
									<dd class="font-medium text-slate-800">{dataBR(e.datas.disputa)}</dd>
									<dd class="text-xs text-slate-500" x-data={`faltam('${e.datas.disputa}')`} x-text="texto" />
								</div>
								<div>
									<dt class="text-xs text-slate-500">Valor estimado</dt>
									<dd class="font-medium text-slate-800">{reaisCurto(e.valorTotal)}</dd>
								</div>
								<div>
									<dt class="text-xs text-slate-500">Seus itens</dt>
									<dd class="font-medium text-slate-800">
										{doRamo.length} de {e.itens.length}
									</dd>
								</div>
							</dl>
							<p class="mt-4 flex flex-wrap items-center gap-2 text-xs text-slate-500">
								<SeloRamo ramo="Sim" /> Disputa em: {e.plataforma.nome} · {e.modo}
							</p>
						</a>
					</li>
				);
			})
		}
	</ul>
</AppLayout>
