---
// Página de um edital. Uma página para cada .json em src/data/editais/.
// - Todos têm a aba "Conferência" (wireframe: Edital · Compatível / Revisão necessária / Parcial).
// - O edital analisado à mão (Barra do Garças) tem também Resumo, Pontos de atenção, Itens, Pedidos de cotação e Controle.
import AppLayout from "@layouts/AppLayout.astro";
import Cabecalho from "@components/edital/Cabecalho.astro";
import AbaConferencia from "@components/edital/AbaConferencia.astro";
import AbaResumo from "@components/edital/AbaResumo.astro";
import AbaPontos from "@components/edital/AbaPontos.astro";
import AbaItens from "@components/edital/AbaItens.astro";
import AbaCotacao from "@components/edital/AbaCotacao.astro";
import AbaControle from "@components/edital/AbaControle.astro";
import { editais, type EditalPagina } from "@data/editais";

export function getStaticPaths() {
	return editais.map((edital) => ({ params: { slug: edital.slug }, props: { edital } }));
}

const { edital } = Astro.props as { edital: EditalPagina };
const c = edital.completo;

const abas = [
	...(c
		? [
				{ id: "resumo", nome: "Resumo", conta: null },
				{ id: "atencao", nome: "Pontos de atenção", conta: c.pontos.length },
			]
		: []),
	{ id: "conferencia", nome: c ? "Conferência (simulação)" : "Conferência", conta: edital.itens.length },
	...(c
		? [
				{ id: "itens", nome: "Itens", conta: c.itens.length },
				{ id: "cotacao", nome: "Pedidos de cotação", conta: c.categorias.length },
				{ id: "controle", nome: "Controle de respostas", conta: null },
			]
		: []),
];
const padrao = c ? "resumo" : "conferencia";

// Dados para o JavaScript do navegador (o "<" vira código para não fechar a tag por engano)
const json = (v: unknown) => JSON.stringify(v).replace(/</g, "\\u003c");
const conferencia = {
	lotes: edital.lotes ?? null,
	itens: edital.itens.map(({ n, tipo, desc, qtd, und, total, resultado, motivo, produto, disp, prova, lote }) => ({ n, tipo, desc, qtd, und, total, resultado, motivo, produto, disp, prova, lote })),
};
---

<AppLayout title={`${edital.titulo} · ${edital.cidade}-${edital.uf}`}>
	{c && <script is:inline type="application/json" id="edital-dados" set:html={json(c)} />}
	<script is:inline type="application/json" id="conferencia-dados" set:html={json(conferencia)} />

	<Cabecalho edital={edital} />

	<div x-data={`abasEdital('${padrao}')`}>
		<!-- Abas (Flex UI › section-heading-05) -->
		<section class="bg-white px-6 sm:px-8 text-gray-800">
			<div class="sem-barra relative overflow-x-auto">
				<ul class="flex min-w-max border-b border-gray-100" role="tablist" aria-label="Partes do edital">
					{
						abas.map((a) => (
							<li>
								<button
									type="button"
									role="tab"
									x-on:click={`ir('${a.id}')`}
									x-bind:aria-selected={`aba === '${a.id}'`}
									class="flex items-center gap-2 px-4 pb-4 text-sm font-medium whitespace-nowrap border-b-2 hover:text-indigo-500 hover:border-indigo-500"
									x-bind:class={`aba === '${a.id}' ? 'text-indigo-500 border-indigo-500' : 'text-gray-500 border-transparent'`}
								>
									{a.nome}
									{a.conta !== null && (
										<span
											class="rounded-md px-2 py-0.5 text-xs font-semibold"
											x-bind:class={`aba === '${a.id}' ? 'bg-indigo-100 text-indigo-500' : 'bg-gray-100 text-gray-500'`}
										>
											{a.conta}
										</span>
									)}
								</button>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- Conteúdo das abas: faixa cinza com cartões brancos, como nos painéis da Flex UI -->
		<section class="min-h-screen bg-gray-50 py-8 text-gray-800">
			<div class="container px-4 sm:px-6 mx-auto">
				<div role="tabpanel" x-show="aba === 'conferencia'" x-cloak={padrao !== "conferencia"}><AbaConferencia slug={edital.slug} /></div>
				{
					c && (
						<>
							<div role="tabpanel" x-show="aba === 'resumo'"><AbaResumo edital={c} /></div>
							<div role="tabpanel" x-show="aba === 'atencao'" x-cloak><AbaPontos edital={c} /></div>
							<div role="tabpanel" x-show="aba === 'itens'" x-cloak><AbaItens edital={c} /></div>
							<div role="tabpanel" x-show="aba === 'cotacao'" x-cloak><AbaCotacao /></div>
							<div role="tabpanel" x-show="aba === 'controle'" x-cloak><AbaControle /></div>
						</>
					)
				}
			</div>
		</section>
	</div>
</AppLayout>
