{
  "extends": "astro/tsconfigs/base",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "checkJs": false,
    "allowJs": true,
    "baseUrl": ".",
    // atalhos de import (os mesmos do starter kit)
    "paths": {
      "@layouts/*": ["src/layouts/*"],
      "@data/*": ["src/data/*"],
      "@styles/*": ["src/styles/*"],
      "@components/*": ["src/components/*"],
      "@scripts/*": ["src/scripts/*"]
    },
    "skipLibCheck": true
  }
}
